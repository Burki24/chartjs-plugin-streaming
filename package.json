{
  "name": "@qultoltd/chartjs-plugin-streaming",
  "homepage": "https://github.com/qultoltd/chartjs-plugin-streaming",
  "description": "Chart.js plugin for live streaming data",
  "author": "Akihiko Kusanagi <nagi@nagi-p.com> (https://nagix.github.io/)",
  "version": "3.5.0",
  "license": "MIT",
  "jsdelivr": "dist/@qultoltd/chartjs-plugin-streaming.min.js",
  "unpkg": "dist/@qultoltd/chartjs-plugin-streaming.min.js",
  "main": "dist/@qultoltd/chartjs-plugin-streaming.js",
  "module": "dist/@qultoltd/chartjs-plugin-streaming.esm.js",
  "types": "types/index.d.ts",
  "packageManager": "npm@11.21.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.x",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "11.x",
      "onFail": "error"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/qultoltd/chartjs-plugin-streaming.git"
  },
  "bugs": {
    "url": "https://github.com/qultoltd/chartjs-plugin-streaming/issues"
  },
  "keywords": [
    "chart.js",
    "plugin",
    "live",
    "streaming",
    "scroll"
  ],
  "files": [
    "bower.json",
    "dist/@qultoltd/*.js",
    "types/*.d.ts"
  ],
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "bower": "node scripts/create-bower-json",
    "build": "rollup -c",
    "build:dev": "rollup -c --watch",
    "docs": "npm run build && vuepress build docs --no-cache",
    "docs:dev": "npm run build && vuepress dev docs --no-cache",
    "lint-js": "eslint \"**/*.{js,cjs}\"",
    "lint-md": "eslint \"**/*.md\"",
    "lint-types": "eslint \"types/**/*.ts\"",
    "lint": "concurrently \"npm:lint-*\"",
    "package": "npm run build && node scripts/create-packages",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node --test tests/browser.cjs tests/jslive-browser.cjs",
    "test:soak": "node tests/jslive-soak.cjs",
    "test:docs": "node --test tests/docs-browser.cjs",
    "verify": "npm run build && npm test && npm run lint && npm run test:browser"
  },
  "devDependencies": {
    "@babel/preset-env": "7.20.2",
    "@rollup/plugin-json": "^6.0.0",
    "@rollup/plugin-node-resolve": "^15.0.1",
    "@typescript-eslint/eslint-plugin": "^5.47.0",
    "@typescript-eslint/parser": "^5.47.0",
    "@vuepress/plugin-html-redirect": "^0.1.4",
    "archiver": "^5.3.0",
    "babel-loader": "8.3.0",
    "chart.js": "^4.1.1",
    "chartjs-current": "npm:chart.js@4.5.1",
    "chartjs-adapter-luxon": "^1.3.0",
    "chartjs-adapter-moment": "1.0.1",
    "chartjs-plugin-annotation": "^2.1.0",
    "chartjs-plugin-datalabels": "^2.2.0",
    "chartjs-plugin-zoom": "^2.0.0",
    "concurrently": "^7.6.0",
    "eslint": "^8.30.0",
    "eslint-config-chartjs": "^0.3.0",
    "eslint-plugin-es": "^4.1.0",
    "eslint-plugin-html": "^7.1.0",
    "eslint-plugin-markdown": "^3.0.0",
    "luxon": "^3.1.1",
    "moment": "2.31.0",
    "ng-hammerjs": "^2.0.8",
    "playwright": "1.63.0",
    "rollup": "^3.7.5",
    "rollup-plugin-analyzer": "^4.0.0",
    "rollup-plugin-cleanup": "^3.2.1",
    "rollup-plugin-minification": "^0.2.0",
    "terser-webpack-plugin": "1.4.5",
    "typescript": "^4.3.4",
    "vuepress": "^1.8.2",
    "vuepress-plugin-flexsearch": "^0.3.0",
    "vuepress-plugin-redirect": "^1.2.5",
    "vuepress-theme-chartjs": "^0.2.0"
  },
  "overrides": {
    "webpack": "4.47.0"
  },
  "peerDependencies": {
    "chart.js": "^4.1.1"
  },
  "streamingMetadata": {
    "sourceCommit": "1a3171771e9bc2637e38db27c918b3376f46801e",
    "build": 27465495,
    "date": 1790948518
  }
}
